# Root / Docker Compose Environment Variables
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/opportunityloop

# Session & Cookie Security (generate a strong 32+ char random string in production)
SESSION_SECRET=change-me-to-a-strong-random-secret-at-least-32-chars
COOKIE_DOMAIN=
SESSION_TTL_DAYS=7

# Rate Limiting
AUTH_RATE_LIMIT_MAX=20
API_RATE_LIMIT_MAX=300

# Optional SMTP Configuration for Email Deadline Reminders (in-app works without this)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=OpportunityLoop <no-reply@example.com>

# Background Reminder Worker Interval (minutes)
REMINDER_INTERVAL_MINUTES=60

# Frontend API Base URL
VITE_API_BASE_URL=http://localhost:5000/api/v1


NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/opportunityloop
USE_IN_MEMORY_DB=false
SESSION_SECRET=change-me-to-a-strong-random-secret-at-least-32-chars
SESSION_TTL_DAYS=7
COOKIE_DOMAIN=
AUTH_RATE_LIMIT_MAX=20
API_RATE_LIMIT_MAX=300
REMINDER_INTERVAL_MINUTES=60

# Optional SMTP for external email reminders
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=OpportunityLoop <no-reply@example.com>

# Local-only dev admin creation script (never commit real secrets)
DEV_ADMIN_NAME=
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=

